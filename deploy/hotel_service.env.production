# Production environment for hotel_service
# Copy to /etc/hotel_service/hotel_service.env and fill all __REPLACE_ME__ values.

# ---------- Database ----------
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/hotel_db?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=hotel_app
SPRING_DATASOURCE_PASSWORD=__REPLACE_ME_DB_PASSWORD__

# ---------- JWT ----------
# Generate a long random secret (at least 64 chars)
JWT_SIGNER_KEY=__REPLACE_ME_JWT_SIGNER_KEY__
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---------- Bootstrap admin ----------
# Keep false in production after first admin seed
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@hotel.your-domain.com
BOOTSTRAP_ADMIN_PASSWORD=__REPLACE_ME_BOOTSTRAP_ADMIN_PASSWORD__

# ---------- Public URLs ----------
APP_MAIL_VERIFY_BASE_URL=https://hotel.your-domain.com/verify-email
APP_MAIL_RESET_BASE_URL=https://hotel.your-domain.com/reset-password
IMAGE_BASE_URL=https://hotel.your-domain.com/images
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://hotel-frontend.onrender.com,https://*.onrender.com,https://*.ngrok-free.dev

# ---------- Image storage ----------
IMAGE_UPLOAD_DIR=/opt/hotel_service/uploads/images

# ---------- Mail ----------
APP_MAIL_ENABLED=true
APP_MAIL_FROM=no-reply@hotel.your-domain.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=__REPLACE_ME_SMTP_USERNAME__
MAIL_PASSWORD=__REPLACE_ME_SMTP_APP_PASSWORD__
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# ---------- VNPay ----------
VNPAY_TMN_CODE=__REPLACE_ME_VNPAY_TMN_CODE__
VNPAY_HASH_SECRET=__REPLACE_ME_VNPAY_HASH_SECRET__
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://hotel.your-domain.com/payment/vnpay-return
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay
VNPAY_CURR_CODE=VND
VNPAY_LOCALE=vn
VNPAY_ORDER_TYPE=other
VNPAY_BANK_CODE=VNPAYQR

# ---------- AI (optional) ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:1b

# ---------- Payment reconcile ----------
APP_PAYMENT_VNPAY_PENDING_TIMEOUT_MINUTES=16
APP_PAYMENT_VNPAY_RECONCILE_DELAY_MS=60000

